# Copy to .env (gitignored) and fill in. Tests and tooling find this file by
# walking up from the package directory, so it also works at the repo root.

# Database used by the schema tests in this package. Each test creates an
# isolated schema and drops it afterwards, so point this at a scratch database
# rather than anything you care about.
TEST_POSTGRES_DSN=postgres://postgres@127.0.0.1:5432/openclaw_test?sslmode=disable

# Set to any non-empty value to turn "database tests skipped" into a failure.
# Skipped tests print "ok", which is indistinguishable from a pass.
# REQUIRE_DB_TESTS=1

# Application database (not used by tests).
POSTGRES_DSN=postgres://postgres@127.0.0.1:5432/openclaw_dev?sslmode=disable

# Llama Guard 3 inference endpoint (Phase 4).
LLAMA_GUARD_URL=http://localhost:8000

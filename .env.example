# Copy to .env (gitignored) and fill in.
#
# No username in these DSNs on purpose: libpq falls back to your OS user, which
# is the role Homebrew's initdb creates. Postgres.app creates one called
# `postgres` instead, so hardcoding either breaks on the other install. Tests and tooling find this file by
# walking up from the package directory, so the repo root is the right place.

# --- Database -------------------------------------------------------------
POSTGRES_DSN=postgres://127.0.0.1:5432/openclaw_dev?sslmode=disable

# Scratch database for the schema tests. Each test builds an isolated schema
# and drops it, so point this somewhere disposable.
TEST_POSTGRES_DSN=postgres://127.0.0.1:5432/openclaw_test?sslmode=disable

# Set to any non-empty value to turn "database tests skipped" into a failure.
# A skipped test prints "ok", which is indistinguishable from a pass.
# REQUIRE_DB_TESTS=1

# --- Gateway --------------------------------------------------------------
LISTEN_ADDR=:8080

# The upstream provider, OpenAI-compatible. Ollama: http://localhost:11434/v1
UPSTREAM_BASE_URL=http://localhost:11434/v1

# The gateway holds the provider key; clients never see it. Ollama needs none.
UPSTREAM_API_KEY=

# Tool name -> capability category. Validated at startup; a bad file is a boot
# failure, because an unclassified tool is a denied tool.
TOOL_REGISTRY_PATH=testdata/tools.json

# --- Identity -------------------------------------------------------------
# The gateway verifies tokens and never mints them, so it holds only the
# public half.
JWT_ISSUER=https://id.example.com
JWT_AUDIENCE=openclaw-gateway
JWT_PUBLIC_KEY_PATH=/etc/openclaw/jwt.pub

# --- Inspection (phase 4) -------------------------------------------------
LLAMA_GUARD_URL=http://localhost:11434

# Budget for the whole inbound inspection phase, not per inspector.
# INSPECT_TIMEOUT=2s
# A model writing a long answer is not a fault, hence the much larger budget.
# UPSTREAM_TIMEOUT=5m
